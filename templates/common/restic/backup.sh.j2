#!/bin/bash

# Source environment variables for restic
source {{ restic_scripts_directory }}/.restic-env

LOG_FILE="{{ restic_logs_directory }}/{{ restic_backup_config.name }}-backup.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

{% set backup_paths = [restic_backup_config.dir_to_backup] if restic_backup_config.dir_to_backup is string else restic_backup_config.dir_to_backup %}

for repo in "{{ restic_backup_config.local_backup_repo }}" "{{ restic_backup_config.remote_backup_repo }}"; do
    if [[ -n "$repo" ]]; then

        log "=============================="
        log "Starting backup for {{ restic_backup_config.name }} in $repo"

        # Unlock repo (in case a previous run left a stale lock)
        restic -r "$repo" unlock >> "$LOG_FILE" 2>&1 || true

        # Run backup
        set +e
        restic -r "$repo" backup \
            {% for path in backup_paths %} "{{ path }}" {% endfor %} \
            {% if restic_backup_config.excludes is defined %}
            {% for path in restic_backup_config.excludes %}
            --exclude "{{ path }}" \
            {% endfor %}
            {% endif %}
            --host "$(hostname -f 2>/dev/null || hostname)" \
            --tag "{{ restic_backup_config.name }}" \
            >> "$LOG_FILE" 2>&1
        backup_rc=$?
        set -e

        if [ $backup_rc -eq 0 ]; then
            log "Backup completed successfully"
        elif [ $backup_rc -eq 3 ]; then
            log "Backup completed with warnings (some source files unreadable), snapshot saved (exit code $backup_rc)"
        else
            log "Backup FAILED (exit code $backup_rc) - no snapshot created, skipping forget/prune"
            continue
        fi

        # Tag as long-term archive snapshot on 15 Jan, 15 May, 15 Sep
        today="$(date +%m-%d)"
        if [ "$today" = "01-15" ] || [ "$today" = "05-15" ] || [ "$today" = "09-15" ]; then
            log "Archive date detected ($today) - tagging latest snapshot as 'archive'"
            restic -r "$repo" tag \
                --add archive \
                --host "$(hostname -f 2>/dev/null || hostname)" \
                --tag "{{ restic_backup_config.name }}" \
                latest \
                >> "$LOG_FILE" 2>&1 || log "Archive tagging encountered issues"
        fi

        # Apply retention policy
        log "Applying retention policy..."
        restic -r "$repo" forget \
            --group-by tags \
            --keep-daily {{ restic_backup_config.retention.daily | default(7) }} \
            --keep-weekly {{ restic_backup_config.retention.weekly | default(5) }} \
            --keep-monthly {{ restic_backup_config.retention.monthly | default(12) }} \
            --keep-tag archive \
            >> "$LOG_FILE" 2>&1 || log "Forget encountered issues"
        log "Retention policy applied"

        # Prune unused data (weekly only - heavy I/O op)
{% raw %}        if [ "$(date +%u)" -eq 7 ]; then
{% endraw %}
            log "Pruning unused data..."
            restic -r "$repo" prune >> "$LOG_FILE" 2>&1 || log "Prune skipped (will retry next run)"
        else
            log "Skipping prune (not scheduled day)"
        fi

        # Snapshot summary
        log "Latest snapshots:"
        restic -r "$repo" snapshots --latest 5 >> "$LOG_FILE" 2>&1 || true

        log "Backup process completed for {{ restic_backup_config.name }} in $repo"

        log "=============================="
    fi
done