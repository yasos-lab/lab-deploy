  openwebui:
    container_name: openwebui
    image: ghcr.io/open-webui/open-webui:main
    volumes:
      - './data/openwebui:/app/backend/data'
    restart: unless-stopped
    mem_limit: 1g
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.openwebui.rule=Host(`openwebui.ai.{{ domain_name }}`)'
      - 'traefik.http.services.openwebui.loadbalancer.server.port=8080'
    networks:
      - 'frontend'
  litellm:
    container_name: litellm
    image: docker.litellm.ai/berriai/litellm-database:latest
    mem_limit: 2g
    restart: unless-stopped
    depends_on:
      litellm-db:
        condition: service_healthy
    environment:
      - 'LITELLM_MASTER_KEY={{ litellm_master_key }}'
      - 'LITELLM_SALT_KEY={{ litellm_salt_key }}'
      - 'DATABASE_URL=postgresql://{{ litellm_db_user }}:{{ litellm_db_password }}@litellm-db:5432/{{ litellm_db_name }}'
      - 'STORE_MODEL_IN_DB=true'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.litellm.rule=Host(`llm.{{ domain_name }}`)'
      - 'traefik.http.services.litellm.loadbalancer.server.port=4000'
      - 'traefik.docker.network=frontend'
    networks:
      - 'frontend'
      - 'backend'
  lobehub:
    container_name: lobehub
    image: lobehub/lobehub:latest
    mem_limit: 2g
    restart: unless-stopped
    depends_on:
      lobehub-db:
        condition: service_healthy
    environment:
      - 'KEY_VAULTS_SECRET={{ lobehub_key_vaults_secret }}'
      - 'AUTH_SECRET={{ lobehub_auth_secret }}'
      - 'DATABASE_URL=postgresql://{{ lobehub_db_user }}:{{ lobehub_db_password }}@lobehub-db:5432/{{ lobehub_db_name }}'
      - 'APP_URL=https://chat.{{ domain_name }}'
      - 'INTERNAL_APP_URL=http://lobehub:3210'
      - 'S3_ENDPOINT=https://s3.{{ domain_name }}'
      - 'S3_BUCKET={{ lobehub_s3_bucket }}'
      - 'S3_ENABLE_PATH_STYLE=1'
      - 'S3_ACCESS_KEY={{ lobehub_s3_access_key }}'
      - 'S3_ACCESS_KEY_ID={{ lobehub_s3_access_key }}'
      - 'S3_SECRET_ACCESS_KEY={{ lobehub_s3_secret_key }}'
      - 'S3_SET_ACL=0'
      - 'LLM_VISION_IMAGE_USE_BASE64=1'
      - 'REDIS_URL=redis://redis:6379'
      - 'REDIS_PREFIX=lobechat'
      - 'REDIS_TLS=0'
      - 'JWKS_KEY={{ lobehub_jwks_key }}'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.lobehub.rule=Host(`chat.{{ domain_name }}`)'
      - 'traefik.http.services.lobehub.loadbalancer.server.port=3210'
      - 'traefik.docker.network=frontend'
    networks:
      - 'frontend'
      - 'backend'
  lobehub-db:
    image: paradedb/paradedb:latest-pg17
    container_name: lobehub-db
    restart: unless-stopped
    mem_limit: 512m
    command: ['postgres', '-c', 'shared_preload_libraries=pg_search']
    environment:
      - 'POSTGRES_USER={{ lobehub_db_user }}'
      - 'POSTGRES_PASSWORD={{ lobehub_db_password }}'
      - 'POSTGRES_DB={{ lobehub_db_name }}'
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ lobehub_db_user }}"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - './data/lobehub-db:/var/lib/postgresql/data'
    networks:
      - 'backend'
  litellm-db:
    image: postgres:16
    container_name: litellm-db
    restart: unless-stopped
    mem_limit: 512m
    environment:
      - 'POSTGRES_USER={{ litellm_db_user }}'
      - 'POSTGRES_PASSWORD={{ litellm_db_password }}'
      - 'POSTGRES_DB={{ litellm_db_name }}'
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ litellm_db_user }}"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - './data/litellm-db:/var/lib/postgresql/data'
    networks:
      - 'backend'
  # ollama:
  #   container_name: ollama
  #   image: ollama/ollama:latest
  #   mem_limit: 1g
  #   volumes:
  #     - './data/ollama:/root/.ollama'
  #   restart: unless-stopped
  #   labels:
  #     - 'traefik.enable=true'
  #     - 'traefik.http.routers.ollama.rule=Host(`ollama.ai.{{ domain_name }}`)'
  #     - 'traefik.http.services.ollama.loadbalancer.server.port=11434'
  #   networks:
  #     - 'frontend'

networks:
  frontend:
    external: True
  backend:
    external: True
