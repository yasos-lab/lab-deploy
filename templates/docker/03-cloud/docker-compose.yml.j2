---

services:
  onlyoffice:
    container_name: onlyoffice
    image: onlyoffice/documentserver:9.2
    mem_limit: 1g
    cpus: 2
    environment:
      - 'JWT_SECRET={{ nextcloud_onlyoffice_jwt }}'
    restart: unless-stopped
    networks:
      - 'frontend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.office.rule=Host(`office.cloud.{{ domain_name }}`)'
      - 'traefik.http.middlewares.x_forwarded_proto.headers.customrequestheaders.X-Forwarded-Proto=https'
      - 'traefik.http.routers.office.middlewares=x_forwarded_proto'
  # paperless:
  #   container_name: paperless
  #   image: ghcr.io/paperless-ngx/paperless-ngx:latest
  #   mem_limit: 1g
  #   cpus: 1
  #   restart: unless-stopped
  #   volumes:
  #     - './data/paperless:/usr/src/paperless/media'
  #     - './config/paperless:/usr/src/paperless/data'
  #   environment:
  #     - 'PAPERLESS_REDIS=redis://redis:6379'
  #     - 'PAPERLESS_SECRET_KEY={{ paperless_secret_key }}'
  #     - 'PAPERLESS_URL=https://paperless.{{ domain_name }}'
  #   networks:
  #     - 'frontend'
  #     - 'backend'
  #   labels:
  #     - 'traefik.enable=true'
  #     - 'traefik.http.routers.paperless.rule=Host(`paperless.{{ domain_name }}`)'
  #     - 'traefik.http.services.paperless.loadbalancer.server.port=8000'
  #     - 'traefik.docker.network=frontend'
  seafile-db:
    container_name: seafile-db
    image: mariadb:10
    mem_limit: 1g
    volumes:
      - './data/seafile-db:/var/lib/mysql'
    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW --log-bin-trust-function-creators=1
    environment:
      - 'MYSQL_ROOT_PASSWORD={{ seafile_root_db_password }}'
      - 'MYSQL_PASSWORD={{ seafile_db_password }}'
      - 'MYSQL_DATABASE={{ seafile_db }}'
      - 'MYSQL_USER={{ seafile_db_user }}'
    restart: unless-stopped
    networks:
      - 'backend'
  seafile:
    container_name: seafile
    image: seafileltd/seafile-mc:13.0-latest
    mem_limit: 2g
    cpus: 2
    volumes:
      - './data/seafile:/shared'
    depends_on:
      - 'seafile-db'
    environment:
      - 'SEAFILE_SERVER_HOSTNAME=drive.{{ domain_name }}'
      - 'SEAFILE_SERVER_PROTOCOL=https'
      - 'INIT_SEAFILE_MYSQL_ROOT_PASSWORD={{ seafile_root_db_password }}'
      - 'SEAFILE_MYSQL_DB_HOST=seafile-db'
      - 'SEAFILE_MYSQL_DB_PORT=3306'
      - 'SEAFILE_MYSQL_DB_USER={{ seafile_db_user }}'
      - 'SEAFILE_MYSQL_DB_PASSWORD={{ seafile_db_password }}'
      - 'SEAFILE_MYSQL_DB_SEAFILE_DB_NAME={{ seafile_db }}'
      - 'SEAFILE_MYSQL_DB_SEAHUB_DB_NAME={{ seafile_seahub_db }}'
      - 'SEAFILE_MYSQL_DB_CCNET_DB_NAME={{ seafile_ccnet_db }}'
      - 'JWT_PRIVATE_KEY={{ seafile_jwt_key }}'
      - 'CACHE_PROVIDER=redis'
      - 'REDIS_HOST=redis'
      - 'REDIS_PORT=6379'
      - 'TIME_ZONE={{ timezone }}'
    restart: unless-stopped
    networks:
      - 'frontend'
      - 'backend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.seafile.rule=Host(`drive.{{ domain_name }}`)'
      - 'traefik.http.services.seafile.loadbalancer.server.port=80'
      - 'traefik.docker.network=frontend'
  immich-server:
    container_name: immich_server
    image: ghcr.io/immich-app/immich-server:release
    mem_limit: 3g
    cpus: 2
    volumes:
      - './data/immich-server:/data'
      - '/etc/localtime:/etc/localtime:ro'
    depends_on:
      - 'immich-redis'
      - 'immich-postgres'
      - 'immich-machine-learning'
    environment:
      - 'TZ={{ timezone }}'
      - 'DB_HOSTNAME=immich-postgres'
      - 'DB_USERNAME=immich'
      - 'DB_PASSWORD={{ immich_db_password }}'
      - 'DB_DATABASE_NAME=immich'
      - 'REDIS_HOSTNAME=immich-redis'
      - 'IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003'
    restart: unless-stopped
    networks:
      - 'frontend'
      - 'backend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.immich.rule=Host(`photos.{{ domain_name }}`)'
      - 'traefik.http.services.immich.loadbalancer.server.port=2283'
      - 'traefik.docker.network=frontend'
  immich-redis:
    container_name: immich_redis
    image: docker.io/valkey/valkey:9
    mem_limit: 256m    
    healthcheck:
      test: 'redis-cli ping || exit 1'
    restart: unless-stopped
    networks:
      - 'backend'
  immich-machine-learning:
    container_name: immich_machine_learning
    image: ghcr.io/immich-app/immich-machine-learning:release
    mem_limit: 2g
    cpus: 2
    volumes:
      - './data/immich-machine-learning:/cache'
    environment:
      - 'TZ={{ timezone }}'
    restart: unless-stopped
    networks:
      - 'backend'
  immich-postgres:
    container_name: immich_postgres
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
    shm_size: 128mb
    mem_limit: 1g
    volumes:
      - './data/immich-postgres:/var/lib/postgresql/data'
    environment:
      - 'POSTGRES_PASSWORD={{ immich_db_password }}'
      - 'POSTGRES_USER=immich'
      - 'POSTGRES_DB=immich'
      - 'POSTGRES_INITDB_ARGS=--data-checksums'
    restart: unless-stopped
    networks:
      - 'backend'
  baikal:
    container_name: baikal
    image: ckulka/baikal:0.10.1-nginx
    mem_limit: 128m
    volumes:
      - './data/baikal/Specific:/var/www/baikal/Specific'
      - './config/baikal:/var/www/baikal/config'
    restart: unless-stopped
    networks:
      - 'frontend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.baikal.rule=Host(`cdav.{{ domain_name }}`)'
      - 'traefik.http.services.baikal.loadbalancer.server.port=80'
      - 'traefik.docker.network=frontend'
  vikunja:
    container_name: vikunja
    image: vikunja/vikunja:latest
    mem_limit: 256m
    user: 0:0
    volumes:
      - './data/vikunja/files:/app/vikunja/files'
      - './data/vikunja/db:/db'
    environment:
      - 'VIKUNJA_SERVICE_PUBLICURL=https://kanban.{{ domain_name }}'
      - 'VIKUNJA_SERVICE_SECRET={{ vikunja_secret }}'
    restart: unless-stopped
    networks:
      - 'frontend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.vikunja.rule=Host(`kanban.{{ domain_name }}`)'
      - 'traefik.http.services.vikunja.loadbalancer.server.port=3456'
      - 'traefik.docker.network=frontend'
  dawarich_db:
    container_name: dawarich_db
    image: postgis/postgis:17-3.5-alpine
    shm_size: 128mb
    mem_limit: 512m
    volumes:
      - './data/dawarich-db:/var/lib/postgresql/data'
    environment:
      - 'POSTGRES_PASSWORD={{ dawarich_db_password }}'
      - 'POSTGRES_USER=dawarich'
      - 'POSTGRES_DB=dawarich'
    restart: unless-stopped
    networks:
      - 'backend'
  dawarich_app:
    container_name: dawarich_app
    image: freikin/dawarich:latest
    mem_limit: 2g
    cpus: 1
    stdin_open: true
    tty: true
    entrypoint: web-entrypoint.sh
    command: ['bin/rails', 'server', '-p', '3000', '-b', '::']
    volumes:
      - './data/dawarich-app/public:/var/app/public'
      - './data/dawarich-app/watched:/var/app/tmp/imports/watched'
      - './data/dawarich-app/storage:/var/app/storage'
    depends_on:
      - 'dawarich_db'
    environment:
      - 'TZ={{ timezone }}'
      - 'RAILS_ENV=production'
      - 'REDIS_URL=redis://redis:6379'
      - 'DATABASE_HOST=dawarich_db'
      - 'DATABASE_PORT=5432'
      - 'DATABASE_USERNAME=dawarich'
      - 'DATABASE_PASSWORD={{ dawarich_db_password }}'
      - 'DATABASE_NAME=dawarich'
      - 'APPLICATION_HOSTS=timeline.{{ domain_name }}'
      - 'APPLICATION_PROTOCOL=https'
      - 'TIME_ZONE={{ timezone }}'
      - 'SECRET_KEY_BASE={{ dawarich_secret_key_base }}'
      - 'SELF_HOSTED=true'
      - 'STORE_GEODATA=true'
    restart: unless-stopped
    networks:
      - 'frontend'
      - 'backend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.dawarich.rule=Host(`timeline.{{ domain_name }}`)'
      - 'traefik.http.services.dawarich.loadbalancer.server.port=3000'
      - 'traefik.docker.network=frontend'
  dawarich_sidekiq:
    container_name: dawarich_sidekiq
    image: freikin/dawarich:latest
    mem_limit: 1g
    cpus: 0.5
    stdin_open: true
    tty: true
    volumes:
      - './data/dawarich-app/public:/var/app/public'
      - './data/dawarich-app/watched:/var/app/tmp/imports/watched'
      - './data/dawarich-app/storage:/var/app/storage'
    depends_on:
      - 'dawarich_db'
      - 'dawarich_app'
    entrypoint: sidekiq-entrypoint.sh
    command: ['sidekiq']
    environment:
      - 'TZ={{ timezone }}'
      - 'RAILS_ENV=production'
      - 'REDIS_URL=redis://redis:6379'
      - 'DATABASE_HOST=dawarich_db'
      - 'DATABASE_PORT=5432'
      - 'DATABASE_USERNAME=dawarich'
      - 'DATABASE_PASSWORD={{ dawarich_db_password }}'
      - 'DATABASE_NAME=dawarich'
      - 'APPLICATION_HOSTS=timeline.{{ domain_name }}'
      - 'APPLICATION_PROTOCOL=https'
      - 'TIME_ZONE={{ timezone }}'
      - 'SECRET_KEY_BASE={{ dawarich_secret_key_base }}'
      - 'SELF_HOSTED=true'
      - 'STORE_GEODATA=true'
    restart: unless-stopped
    networks:
      - 'frontend'
      - 'backend'
  searxng:
    container_name: searxng
    image: docker.io/searxng/searxng:latest
    restart: unless-stopped
    mem_limit: 512m
    volumes:
      - './config/searxng:/etc/searxng/'
      - './data/searxng:/var/cache/searxng/'
    environment:
      - 'SEARXNG_VALKEY_URL=redis://redis:6379'
    networks:
      - 'frontend'
      - 'backend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.searxng.rule=Host(`search.{{ domain_name }}`)'
      - 'traefik.http.services.searxng.loadbalancer.server.port=8080'
      - 'traefik.docker.network=frontend'
networks:
  frontend:
    external: True
  backend:
    external: True
