---

services:
  nextcloud:
    container_name: nextcloud
    image: nextcloud:32
    volumes:
      - './data/nextcloud:/var/www/html'
      - './config/nextcloud/nextcloud.ini:/usr/local/etc/php/conf.d/nextcloud.ini'
    depends_on:
      - 'redis'
      - 'maria-db'
      - 'onlyoffice'
    environment:
      - 'MYSQL_HOST=maria-db'
      - 'MYSQL_PASSWORD={{ nextcloud_db_password }}'
      - 'MYSQL_DATABASE={{ nextcloud_db }}'
      - 'MYSQL_USER={{ nextcloud_db_user }}'
      - 'REDIS_HOST=redis'
      - 'TRUSTED_PROXIES={{ lan_prefix }}.11'
      - 'NEXTCLOUD_TRUSTED_DOMAINS=cloud.{{ domain_name }}'
      - 'OVERWRITECLIURL=https://cloud.{{ domain_name }}'
      - 'OVERWRITEPROTOCOL=https'
    restart: unless-stopped
    networks:
      - 'frontend'
      - 'backend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.nextcloud.tls=true'
      - 'traefik.http.routers.nextcloud.tls.certresolver=cloudflare'
      - 'traefik.http.routers.nextcloud.rule=Host(`cloud.{{ domain_name }}`)'
      - 'traefik.http.middlewares.secure_headers.headers.stsSeconds=15552000'
      - 'traefik.http.middlewares.secure_headers.headers.stsIncludeSubdomains=true'
      - 'traefik.http.middlewares.secure_headers.headers.stsPreload=true'
      - 'traefik.http.routers.nextcloud.middlewares=secure_headers'
      - 'traefik.docker.network=frontend'
  redis:
    container_name: redis
    image: redis:6
    restart: unless-stopped
    healthcheck: 
      test: 'redis-cli ping || exit 1'
    networks:
      - 'backend'
  maria-db:
    container_name: maria-db
    image: mariadb:10
    volumes:
      - './data/maria-db:/var/lib/mysql'
    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW --log-bin-trust-function-creators=1
    environment:
      - 'MYSQL_ROOT_PASSWORD={{ nextcloud_root_db_password }}'
      - 'MYSQL_PASSWORD={{ nextcloud_db_password }}'
      - 'MYSQL_DATABASE={{ nextcloud_db }}'
      - 'MYSQL_USER={{ nextcloud_db_user }}'
    restart: unless-stopped
    networks:
      - 'backend'
  onlyoffice:
    container_name: onlyoffice
    image: onlyoffice/documentserver:latest
    environment:
      - 'JWT_SECRET={{ nextcloud_onlyoffice_jwt }}'
    restart: unless-stopped
    networks:
      - 'frontend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.office.tls=true'
      - 'traefik.http.routers.office.tls.certresolver=cloudflare'
      - 'traefik.http.routers.office.rule=Host(`office.cloud.{{ domain_name }}`)'
      - 'traefik.http.middlewares.x_forwarded_proto.headers.customrequestheaders.X-Forwarded-Proto=https'
      - 'traefik.http.routers.office.middlewares=x_forwarded_proto'
  paperless:
    container_name: paperless
    image: ghcr.io/paperless-ngx/paperless-ngx:latest
    restart: unless-stopped
    depends_on:
      - redis
    volumes:
      - './data/paperless:/usr/src/paperless/media'
      - './config/paperless:/usr/src/paperless/data'
    environment:
      - 'PAPERLESS_REDIS=redis://redis:6379'
      - 'PAPERLESS_URL=https://paperless.{{ domain_name }}'
    networks:
      - 'frontend'
      - 'backend'
    labels:
      - 'traefik.enable=true'
      - 'traefik.http.routers.paperless.tls=true'
      - 'traefik.http.routers.paperless.tls.certresolver=cloudflare'
      - 'traefik.http.routers.paperless.rule=Host(`paperless.{{ domain_name }}`)'
      - 'traefik.http.services.paperless.loadbalancer.server.port=8000'
      - 'traefik.docker.network=frontend'
networks:
  frontend:
    external: True
  backend:
    external: True