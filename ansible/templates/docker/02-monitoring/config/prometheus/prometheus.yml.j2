global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'tc_debian_server'
    static_configs:
      - targets: ['node_exporter:9100']

  - job_name: 'raspberrypi'
    static_configs:
      - targets: ['{{ lan_prefix }}.10:9100']

  - job_name: 'cadvisor'
    scrape_interval: 30s
    static_configs:
      - targets: ['cadvisor:8080']
  
  - job_name: 'traefik'
    static_configs:
      - targets: ['traefik:9100']
